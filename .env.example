# ── Base de datos (obligatoria) ─────────────────────────────────────────────
# PostgreSQL 16+ con las extensiones pg_trgm, unaccent y vector (pgvector).
DATABASE_URL=postgres://usuario:contraseña@host:5432/alexandria
# Supabase desde Vercel: pooler en modo SESIÓN (puerto 5432, IPv4):
#   DATABASE_URL=postgres://ROL.REF:CLAVE@aws-N-REGION.pooler.supabase.com:5432/postgres?sslmode=require
#   DATABASE_POOL_MAX=3            (por instancia en ejecución)
#   DATABASE_POOL_MAX_BUILD=8      (durante next build; mínimo efectivo 10)
# Con poolers en modo transacción (PgBouncer, Supabase :6543) usa DATABASE_PREPARE=false.
DATABASE_PREPARE=true
DATABASE_POOL_MAX=10
# Base separada para las pruebas de integración (se vacía en cada ejecución).
TEST_DATABASE_URL=postgres://usuario:contraseña@host:5432/alexandria_test

# ── Aplicación ──────────────────────────────────────────────────────────────
# URL pública canónica (se usa en correos, sitemap y metadatos sociales).
APP_URL=https://alexandria.example.org

# ── Correo (opcional) ───────────────────────────────────────────────────────
# Sin SMTP_HOST, los correos (p. ej. recuperación de contraseña) NO se envían:
# en desarrollo se escriben en la consola del servidor; en producción se registra
# un error. Cualquier proveedor SMTP sirve (Amazon SES, Postmark, Mailgun, etc.).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="ALEXANDRIA <no-reply@alexandria.example.org>"

# ── Administración inicial (solo para `npm run db:create-admin`) ────────────
ADMIN_EMAIL=
ADMIN_PASSWORD=
